class range{
    fn __init__(start,end,step){
        this.start=1
        this.end=10
        this.step=1
    }
    fn __iter__(){
        return this
    }

    fn __next__(){
        if this.start<this.end{
            let result=this.start
            this.start=this.start+this.step
            return result
        }
        return undefined
    }

    fn __str__(){
        return "range"
    }
}


let r=range()

foreach i in r{
    print(i)
}
