class vec2 {
    fn __init__(x, y){
        this.x = x
        this.y = y
    }

    fn __getitem__(index){
        if index == 0 {
            return this.x
        }
        return this.y
    }

    fn __setitem__(index, value){
        if index == 0 {
            this.x = value
        }else{
            this.y = value
        }
    }

    fn __add__(other){
        return vec2(this.x+other.x, this.y+other.y)
    }

    fn __str__(){
        return "{x:" + this.x + ",y:" + this.y + "}"
    }
}


let x=vec2(1, 2)
let y=vec2(3, 4)

let z=x+y
print(z)
