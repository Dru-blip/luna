class Pair {
    fn __init__(a, b){
        this.a = a
        this.b = b
    }

    fn __add__(other){
        return Pair(this.a + other.a, this.b + other.b)
    }

    fn __radd__(other){
        return Pair(other.a + this.a, other.b + this.b)
    }

    fn __sub__(other){
        return Pair(this.a - other.a, this.b - other.b)
    }

    fn __mul__(other){
        return Pair(this.a * other.a, this.b * other.b)
    }

    fn __div__(other){
        return Pair(this.a / other.a, this.b / other.b)
    }

    fn __mod__(other){
        return Pair(this.a % other.a, this.b % other.b)
    }

    fn __lt__(other){
        return this.a < other.a && this.b < other.b
    }

    fn __gt__(other){
        return this.a > other.a && this.b > other.b
    }

    fn __eq__(other){
        return this.a == other.a && this.b == other.b
    }

    fn __ne__(other){
        return this.a != other.a && this.b != other.b
    }

    fn __str__(){
        return "(" + this.a + ", " + this.b + ")"
    }

    fn __len__(){
        return 2
    }
}


raise Exception("Guard failed")
