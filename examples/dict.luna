class Pair {
    fn __init__(a, b){
        this.a = a
        this.b = b
    }

    fn __hash__(){
        return hash(this.a) ^ hash(this.b)
    }

    fn __eq__(other){
        return this.a == other.a and this.b == other.b
    }

   fn __str__(){
        return "(" + this.a + ", " + this.b + ")"
    }
}

let a=Pair(1, 2)
let b=Pair(1, 2)

let c={a:b,b:a}
print(c[a])
