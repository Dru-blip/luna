class NotImplementedError : Exception{
    fn __init__(msg){
        this.a=5
    }
}

guard {
   raise NotImplementedError("not implemented")
}
rescue NotImplementedError{
    print("from NotImplementedError rescue block")
}
rescue InvalidAssignmentTargetError{
    print("from InvalidAssignmentTargetError rescue block")
}
ensure{
    print("from ensure block")
}
