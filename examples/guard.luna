class AError : Exception {}
class BError : Exception {}
class CError : Exception {}

guard {
    guard {
        guard {
            print("level 1")
            raise AError("from level 1")
        }
        rescue BError {
            print("caught BError at level 2")
        }
    }
    rescue AError {
        print("caught AError at level 2")
        raise BError("rethrow as BError")
    }
}
rescue BError {
    print("caught BError at level 3")
}
ensure {
    print("final cleanup")
}
